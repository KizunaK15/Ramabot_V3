<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="default">
    <!-- Pencahayaan & Elemen Dasar -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Optimasi Engine Fisika ODE -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
        </solver>
      </ode>
    </physics>

    <!-- Pengaturan Scene & Bayangan -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

